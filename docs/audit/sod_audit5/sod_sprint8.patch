+.overlay-pane {
+  position: absolute;
+  top: 0;
+  left: 0;
+}
+
+.overlay-pane .pdf-page { margin: 0; }
+
+.overlay-pane--base { position: relative; }
+
+.overlay-pane--top {
+  pointer-events: none;
+  will-change: transform, opacity;
+}
+
+.overlay-hud {
+  flex: 0 0 auto;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px 14px;
+  padding: 6px 12px;
+  font-size: 11.5px;
+  color: var(--c-text-on-dark-muted, #B4B5BA);
+  background: var(--c-viewer-raised, #2B2C30);
+  border-top: 1px solid var(--c-viewer-border, #3A3B40);
+}
+
+.overlay-hud__top { color: var(--c-accent-on-header, #9FB6DF); }
+
+.overlay-hud__hint { margin-left: auto; opacity: .75; }
+
+/* Меню сравнения */
+
+.compare-menu .dropdown-menu {
+  min-width: 230px;
+  box-shadow: 0 12px 30px rgba(15, 23, 42, .22);
+}
+
+.compare-menu-dropdown .dropdown-item {
+  border-radius: 6px;
+  font-size: 13px;
+  padding: 6px 10px;
+}
+
+.compare-menu-dropdown .dropdown-item:hover,
+.compare-menu-dropdown .dropdown-item:focus-visible {
+  background: var(--c-accent-subtle, #EDF1F7);
+  color: var(--c-accent, #3D5A98);
+}
+
+#compareMenuBtn.active {
+  border-color: var(--c-accent, #3D5A98);
+  color: var(--c-accent, #3D5A98);
+}
