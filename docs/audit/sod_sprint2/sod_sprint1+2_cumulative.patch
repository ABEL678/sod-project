+                    </div>
+                </div>
+            </form>
+        </div>
+
+        {# ---- Таблица реестра ---- #}
+        <div class="card shadow-sm">
+            <div class="table-responsive">
+                <table class="table table-hover align-middle mb-0">
+                    <thead class="table-light">
+                        <tr>
+                            <th>№</th>
+                            <th>Документ</th>
+                            <th>Статус</th>
+                            <th style="min-width: 280px;">Текст замечания</th>
+                            <th>Автор</th>
+                            <th>Ответственный</th>
+                            <th>Срок ответа</th>
+                            <th>Создано</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                    {% for issue in issues %}
+                        <tr>
+                            <td><span class="cde-chip">{{ issue.pk }}</span></td>
+                            <td>
+                                <a href="{% url 'storage:document_detail' issue.document.pk %}"
+                                   class="fw-semibold text-decoration-none">
+                                    {{ issue.document.code }}
+                                </a>
+                                <div class="small text-muted text-truncate" style="max-width: 220px;">
+                                    {{ issue.document.name }}
+                                </div>
+                            </td>
+                            <td>
+                                <span class="{{ issue|status_badge_class }}">
+                                    {{ issue.get_status_display }}
+                                </span>
+                            </td>
+                            <td>
+                                <span title="{{ issue.description }}">{{ issue.description|truncatechars:110 }}</span>
+                            </td>
+                            <td class="small">
+                                {{ issue.author.get_full_name|default:issue.author.username }}
+                            </td>
+                            <td class="small">
+                                {% if issue.assignee %}
+                                    {{ issue.assignee.get_full_name|default:issue.assignee.username }}
+                                {% else %}—{% endif %}
+                            </td>
+                            <td>
+                                {% if issue.due_date %}
+                                    <span class="cde-tnum">{{ issue.due_date|date:"d.m.Y" }}</span>
+                                    {% if issue|deadline_label %}
+                                        <div class="mt-1">
+                                            <span class="{{ issue|deadline_class }}">{{ issue|deadline_label }}</span>
+                                        </div>
+                                    {% endif %}
+                                {% else %}—{% endif %}
+                            </td>
+                            <td class="small cde-tnum">{{ issue.created_at|date:"d.m.Y" }}</td>
+                        </tr>
+                    {% empty %}
+                        <tr>
+                            <td colspan="8" class="text-center text-muted py-4">
+                                {% if filters.q or filters.status or filters.flag or filters.assignee %}
