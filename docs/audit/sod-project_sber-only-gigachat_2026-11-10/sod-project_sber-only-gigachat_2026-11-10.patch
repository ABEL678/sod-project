@@ -0,0 +1,204 @@
+"""GigaChatEmbedding: батчи /v1/embeddings, порядок по index, dim-контроль.
+
+Сеть не используется: httpx.post (OAuth) и httpx.Client (embeddings)
+мокаются фейками, которые пишут вызовы. Фабрика get_embedding_service
+проверяется через override_settings.
+"""
+
+from unittest.mock import patch
+
+from django.test import SimpleTestCase, override_settings
+
+import ai_checks.adapters.embedding_gigachat as embedding_gigachat
+from ai_checks.adapters.embedding_gigachat import (
+    GigaChatEmbedding,
+    get_embedding_service,
+)
+
+
+class FakeResponse:
+    def __init__(self, data, status_code=200):
+        self._data = data
+        self.status_code = status_code
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            import httpx
+            request = httpx.Request('POST', 'http://fake')
+            raise httpx.HTTPStatusError(
+                f'HTTP {self.status_code}',
+                request=request,
+                response=httpx.Response(
+                    self.status_code, request=request,
+                ),
+            )
+
+    def json(self):
+        return self._data
+
+
+class FakeClient:
+    """Фейковый httpx.Client: пишет вызовы, отдаёт векторы по dim."""
+
+    posts: list[dict] = []
+    status_code = 200
+    dim = 1024
+
+    def __init__(self, *args, **kwargs):
+        self.init_kwargs = kwargs
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc_info):
+        return False
+
+    def post(self, url, headers=None, json=None, data=None):
+        FakeClient.posts.append({
+            'url': url,
+            'headers': headers or {},
+            'json': json,
+        })
+        texts = (json or {}).get('input') or []
+        return FakeResponse(
+            {
+                'data': [
+                    {
+                        'index': index,
+                        'object': 'embedding',
+                        'embedding': [0.5] * FakeClient.dim,
+                    }
+                    for index in range(len(texts))
+                ],
+                'model': (json or {}).get('model', 'Embeddings'),
+            },
+            status_code=FakeClient.status_code,
+        )
+
+
+def fake_oauth_post(url, headers=None, data=None, timeout=None, verify=None):
+    FakeClient.posts.append({'url': url, 'headers': headers or {}})
+    return FakeResponse({'access_token': 'giga-token-emb-1'})
+
+
+class GigaChatEmbeddingTests(SimpleTestCase):
+    def setUp(self):
+        FakeClient.posts = []
+        FakeClient.status_code = 200
+        FakeClient.dim = 1024
+
+    def _service(self):
+        return GigaChatEmbedding(
+            'base64-authorization-key',
+            model='Embeddings',
+            dim=1024,
+            batch_size=2,
+        )
+
+    def test_embed_texts_batches_and_maps_by_index(self):
+        with patch.object(
+            embedding_gigachat.httpx, 'post', side_effect=fake_oauth_post,
+        ), patch.object(
+            embedding_gigachat.httpx, 'Client', FakeClient,
+        ):
+            service = self._service()
+            vectors = service.embed_texts(['а', 'б', 'в'])
+
+        self.assertEqual(len(vectors), 3)
+        self.assertEqual(len(vectors[0]), 1024)
+        embeddings_calls = [
+            call for call in FakeClient.posts
+            if call['url'].endswith('/embeddings')
+        ]
+        # 3 текста при batch_size=2 → два батча.
+        self.assertEqual(len(embeddings_calls), 2)
+        self.assertEqual(
+            embeddings_calls[0]['json']['input'], ['а', 'б'],
+        )
+        self.assertEqual(
+            embeddings_calls[1]['json']['input'], ['в'],
+        )
+        self.assertEqual(embeddings_calls[0]['json']['model'], 'Embeddings')
+        oauth_calls = [
+            call for call in FakeClient.posts if 'oauth' in call['url']
+        ]
+        self.assertEqual(len(oauth_calls), 1, 'токен кэшируется между батчами')
+        self.assertEqual(
+            embeddings_calls[0]['headers']['Authorization'],
+            'Bearer giga-token-emb-1',
+        )
+        self.assertEqual(
+            embeddings_calls[0]['url'],
+            'https://api.giga.chat/v1/embeddings',
+        )
+
+    def test_empty_texts_no_request(self):
+        service = self._service()
+        self.assertEqual(service.embed_texts([]), [])
+        self.assertEqual(FakeClient.posts, [])
+
+    def test_dim_mismatch_raises_with_hint(self):
+        FakeClient.dim = 1536  # модель вернула не 1024
+        with patch.object(
+            embedding_gigachat.httpx, 'post', side_effect=fake_oauth_post,
+        ), patch.object(
+            embedding_gigachat.httpx, 'Client', FakeClient,
+        ):
+            service = self._service()
+            with self.assertRaises(RuntimeError) as ctx:
+                service.embed_texts(['текст'])
+        self.assertIn('AI_EMBEDDING_DIM', str(ctx.exception))
+
+    def test_model_version_reflects_model(self):
+        service = self._service()
+        self.assertEqual(service.dim, 1024)
+        self.assertEqual(service.model_version, 'gigachat:Embeddings:v1')
+
+
+class FactoryTests(SimpleTestCase):
+    def setUp(self):
+        FakeClient.posts = []
+
+    @override_settings(AI_GIGACHAT_AUTH_KEY='key-1')
+    def test_factory_default_gigachat(self):
+        service = get_embedding_service()
+        self.assertIsInstance(service, GigaChatEmbedding)
+        self.assertEqual(service.authorization_key, 'key-1')
+
+    @override_settings(
+        AI_GIGACHAT_AUTH_KEY='key-1',
+        AI_EMBEDDING_MODEL='EmbeddingsGigaR',
+        AI_EMBEDDING_DIM=1024,
+    )
+    def test_factory_uses_configured_model(self):
+        service = get_embedding_service()
+        self.assertEqual(service.model, 'EmbeddingsGigaR')
+
+    @override_settings(
+        AI_GIGACHAT_AUTH_KEY='',
+        AI_EMBEDDING_PROVIDER='gigachat',
+    )
+    def test_factory_gigachat_without_key_raises(self):
+        with self.assertRaises(RuntimeError) as ctx:
+            get_embedding_service()
+        self.assertIn('AI_GIGACHAT_AUTH_KEY', str(ctx.exception))
+
+    @override_settings(AI_EMBEDDING_PROVIDER='onnx')
+    def test_factory_onnx_fallback(self):
+        # Подменяем класс: реальный BgeM3OnnxEmbedding требует model.onnx.
+        from ai_checks.adapters import embedding_onnx
+
+        class _FakeOnnx:
+            pass
+
+        with patch.object(embedding_onnx, 'BgeM3OnnxEmbedding', _FakeOnnx):
+            service = get_embedding_service()
+        self.assertIsInstance(service, _FakeOnnx)
+
+    @override_settings(
+        AI_GIGACHAT_AUTH_KEY='key-1', AI_EMBEDDING_PROVIDER='sha256',
+    )
+    def test_factory_unknown_provider_raises(self):
+        with self.assertRaises(RuntimeError) as ctx:
+            get_embedding_service()
+        self.assertIn('AI_EMBEDDING_PROVIDER', str(ctx.exception))
