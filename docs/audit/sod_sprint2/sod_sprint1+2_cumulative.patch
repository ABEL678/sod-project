diff --git a/storage/adapters/templates/storage/base.html b/storage/adapters/templates/storage/base.html
new file mode 100644
index 0000000..a9ddba6
--- /dev/null
+++ b/storage/adapters/templates/storage/base.html
@@ -0,0 +1,37 @@
+{% load static %}
+{% comment %}
+Базовый шаблон всех «приложных» страниц СОД (кроме полноэкранного вьювера
+document_detail — у него своя разметка и свой набор стилей).
+
+Что даёт:
+  - один <head> на все страницы: viewport, bootstrap, ДИЗАЙН-ТОКЕНЫ,
+    bootstrap-icons, redesign, app.css;
+  - tokens.css теперь грузится везде — cde-badge/cde-chip/cde-deadline
+    работают на любой странице, а не только во вьювере;
+  - единая точка подключения скриптов: bootstrap.bundle всегда доступен
+    (раньше на части страниц модалки не работали без can_create_project).
+
+Блоки: title, extra_css, topbar, body_class, content, extra_js.
+{% endcomment %}
+<!DOCTYPE html>
+<html lang="ru">
+<head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>{% block title %}Stream-CAD{% endblock %}</title>
+    <link rel="stylesheet" href="{% static 'css/bootstrap.min.css' %}">
+    <link rel="stylesheet" href="{% static 'design-tokens/tokens.css' %}?v=20261102">
+    <link rel="stylesheet" href="{% static 'css/redesign.css' %}">
+    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
+    <link rel="stylesheet" href="{% static 'css/app.css' %}?v=20261102">
+    {% block extra_css %}{% endblock %}
+</head>
+<body class="{% block body_class %}bg-light{% endblock %}">
+{% block topbar %}
+    {% include 'storage/_topbar.html' %}
+{% endblock %}
+{% block content %}{% endblock %}
+<script src="{% static 'js/vendor/bootstrap.bundle.min.js' %}"></script>
+{% block extra_js %}{% endblock %}
+</body>
+</html>
