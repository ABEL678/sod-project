# Пример переменных окружения для СОД.
# Скопируйте значения в окружение (PyCharm Run Configuration / systemd / export).
# Файл .env в корне проекта читается автоматически (python-dotenv,
# sod_core/settings.py: load_dotenv).

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# HTTPS / cookies.
# На VPS включите оба флага; локально для HTTP оставьте False.
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True

# PostgreSQL.
# Если POSTGRES_DB задан — используется PostgreSQL, иначе SQLite.
# На сервере дополнительно установите psycopg (в requirements не входит).
# POSTGRES_DB=sod
# POSTGRES_USER=sod
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# ИИ-контур (RAG-поиск, база знаний, отчёт ГИПу).
# Фича-флаг: False — контур выключен (вкладки скрыты, вьюхи отдают 404).
AI_CHECKS_ENABLED=False

# LLM: только GigaChat (Сбер, работа из РФ). OrcaRouter удалён
# (зачистка 2026-11-10, «только экосистема Сбера»). Authorization Key
# из личного кабинета GigaChat (Base64). Без ключа работает заглушка
# StubLLMProvider (контур не падает, ответ синтезируется из фрагментов).
AI_GIGACHAT_AUTH_KEY=
# Модель по умолчанию, если в UI не выбрана (GigaChat-2-Max проверен).
AI_GIGACHAT_MODEL=GigaChat-2-Max
AI_GIGACHAT_TIMEOUT=60
# TLS: НУЦ Минцифры установлен → True; иначе False (осознанно, dev).
AI_GIGACHAT_VERIFY_SSL=True
# Базовый URL OpenAI-совместимого API GigaChat (обычно менять не нужно).
AI_GIGACHAT_API_BASE_URL=https://api.giga.chat/v1

# Эмбеддинги: облако Сбера (AI_EMBEDDING_PROVIDER=gigachat) или
# офлайн-фолбэк bge-m3 (onnx). Выбор модели GigaChat: Embeddings,
# Embeddings-2, Embeddings-3B-2025-09, EmbeddingsGigaR.
# ВАЖНО: смена модели эмбеддингов = полная переиндексация документов
# («Переиндексировать проект» + перезагрузка базы знаний).
AI_EMBEDDING_PROVIDER=gigachat
AI_EMBEDDING_MODEL=Embeddings
# Размерность вектора (колонки pgvector — 1024). Если выбранная модель
# выдаёт другую размерность, адаптер упадёт с понятной ошибкой.
AI_EMBEDDING_DIM=1024
AI_EMBEDDING_BATCH_SIZE=8
AI_EMBEDDING_TIMEOUT=60
# Папка bge-m3 (model.onnx + токенизатор) — только при
# AI_EMBEDDING_PROVIDER=onnx; без модели индексация падает с ошибкой.
AI_EMBEDDING_MODEL_DIR=
