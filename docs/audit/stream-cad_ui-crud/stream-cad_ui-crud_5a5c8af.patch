+{% comment %}
+UI-аудит (треб. 2.2/3.2): модалка загрузки документа.
+Поля: файл, «Код документа» (опционально — пустой шифр генерируется по
+ГОСТ Р 21.101 на сервере) и «Тип документа» (пусто — определяется по
+расширению файла). Отправка через app.js (handleFiles) на
+storage:document_upload_ajax — тот же endpoint, что у DnD-загрузки.
+Для нескольких файлов поля «Код документа» и «Тип документа»
+отключаются: шифр генерируется каждому файлу, тип — по расширению.
+{% endcomment %}
+<div class="modal fade" id="uploadModal" tabindex="-1"
+     aria-labelledby="uploadModalLabel" aria-hidden="true">
+  <div class="modal-dialog">
+    <div class="modal-content">
+      <form id="uploadModalForm">
+        <div class="modal-header">
+          <h5 class="modal-title" id="uploadModalLabel">Загрузка документа</h5>
+          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
+        </div>
+        <div class="modal-body">
+          <div class="mb-3">
+            <label class="form-label small" for="uploadModalTarget">Куда загружаем</label>
+            <input type="text" class="form-control form-control-sm" id="uploadModalTarget"
+                   value="{{ upload_target_name }}" readonly>
+          </div>
+          <div class="mb-3">
+            <label class="form-label small" for="uploadModalFile">Файл</label>
+            <input type="file" class="form-control form-control-sm"
+                   id="uploadModalFile" multiple required>
+            <div class="form-text d-none" id="uploadModalMultiHint"></div>
+          </div>
+          <div class="mb-3">
