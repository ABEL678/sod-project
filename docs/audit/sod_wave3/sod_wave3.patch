+            activeIndex = 0;
+        } else {
+            activeIndex = Math.min(flatItems.length - 1, Math.max(0, activeIndex + delta));
+        }
+        var buttons = results.querySelectorAll('.cmdk-item');
+        buttons.forEach(function (button, index) {
