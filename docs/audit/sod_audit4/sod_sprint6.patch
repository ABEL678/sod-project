+
+/* ==================== Спринт 6: UX-полировка ==================== */
+
+/* Skip-link: виден только при фокусе с клавиатуры */
+.skip-link {
+    position: absolute;
+    left: -9999px;
+    top: 0;
+    z-index: 2000;
+    background: var(--c-bg-header);
+    color: var(--c-text-on-dark);
+    padding: 10px 18px;
+    border-radius: 0 0 10px 0;
+    font-size: 13px;
+    text-decoration: none;
+}
+.skip-link:focus-visible {
+    left: 0;
+    outline: 2px solid var(--c-accent-on-header);
+    outline-offset: -2px;
+}
+
+/* Статус загрузки файлов в тулбаре реестра */
+.upload-status {
+    font-size: 12.5px;
+    color: var(--c-text-secondary);
+    max-width: 340px;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+.upload-status.is-error { color: #B42318; font-weight: 500; }
+
+/* Спиннер HTMX-запросов реестра: появляется, пока панель обновляется */
+.panel-spinner {
+    display: none;
+    color: var(--c-text-secondary);
+    font-size: 15px;
+    animation: panel-spin 0.9s linear infinite;
+}
+#documentsPanel.htmx-request .panel-spinner { display: inline-block; }
+@keyframes panel-spin { to { transform: rotate(360deg); } }
+
+/* Видимая кнопка меню папки (раньше — только правый клик) */
+.folder-kebab {
+    color: var(--c-text-secondary);
+    line-height: 1;
+    flex: 0 0 auto;
+    opacity: 0;
+    transition: opacity 120ms ease;
+}
+.folder-row:hover .folder-kebab,
+.folder-row:focus-within .folder-kebab,
+.folder-kebab:focus-visible { opacity: 1; }
+.folder-kebab:hover { color: var(--c-accent); }
+
+@media (prefers-reduced-motion: reduce) {
+    .panel-spinner { animation: none; }
+}
