+        add(_var('shadow-{key}'.format(key=key), value))
+    add('')
+    add('  /* --- Моушн --- */')
+    add('  ' + ' '.join(
+        '--dur-{key}: {value};'.format(key=key, value=value)
+        for key, value in motion.items()
+        if key != 'ease-out'
