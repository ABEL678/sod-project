{
  "$description": "Дизайн-токены CDE «Среда общих данных» (проектная организация, строительство). Единый источник истины: из этого файла генерируются tokens.css и tailwind.config.js. Версия 1.0 · 31.10.2026 · по итогам UI/UX-аудита",
  "color": {
    "$type": "color",
    "bg": {
      "app":           { "$value": "#F6F6F4", "$description": "Фон приложения — тёплый «бумажный» серый (замена холодного #F8F9FA)" },
      "surface":       { "$value": "#FFFFFF", "$description": "Карточки, панели, строки таблиц" },
      "surfaceHover":  { "$value": "#FAFAF8", "$description": "Ховер строк таблиц и пунктов списков" },
      "surfaceSunken": { "$value": "#EFEFEC", "$description": "Утопленные зоны: подвалы карточек, поля composer" },
      "canvas":        { "$value": "#26272B", "$description": "Тёмный canvas вьювера под листом документа" }
    },
    "border": {
      "hairline": { "$value": "#E4E4E0", "$description": "Основные тонкие границы (1px)" },
      "default":  { "$value": "#D4D4CE", "$description": "Поля ввода, акцентные границы" }
    },
    "text": {
      "primary":     { "$value": "#191917", "$description": "Основной текст — мягкий чёрный" },
      "secondary":   { "$value": "#6E6E68" },
      "muted":       { "$value": "#9C9C94", "$description": "Метаданные, плейсхолдеры" },
      "onDark":      { "$value": "#F2F2EF", "$description": "Текст на тёмном canvas" },
      "onDarkMuted": { "$value": "#A6A7AC" },
      "inverse":     { "$value": "#FFFFFF", "$description": "Текст на акценте и статусах solid" }
    },
    "accent": {
      "base":     { "$value": "#2F5BEA", "$description": "ЕДИНСТВЕННЫЙ бренд-акцент: primary-кнопки, ссылки, активные состояния" },
      "hover":    { "$value": "#2447C4" },
      "pressed":  { "$value": "#1D3BA8" },
      "subtle":   { "$value": "#ECF0FE", "$description": "Фон выделения активных пунктов, инфо-плашек" },
      "onSubtle": { "$value": "#1E41B8" }
    },
    "status": {
      "$description": "Семантика статусов. Правило: solid — иконки/маркеры/мелкие бейджи, subtle — фоны бейджей (текст onSubtle), контраст WCAG AA. Один смысл — один цвет во ВСЕХ контекстах: панель, бейдж, маркер на листе",
      "attention": {
        "$description": "Требует реакции пользователя: Не принято, Просрочено",
        "solid":    { "$value": "#DC2626" },
        "subtle":   { "$value": "#FDECEC" },
        "onSubtle": { "$value": "#B91C1C" }
      },
      "wait": {
        "$description": "Ожидание действия: Открыто, На проверке, Ожидает ответа",
        "solid":    { "$value": "#D97706" },
        "subtle":   { "$value": "#FCF3E6" },
        "onSubtle": { "$value": "#B45309" }
      },
      "progress": {
        "$description": "Работа идёт: В работе, Обсуждение",
        "solid":    { "$value": "#2563EB" },
        "subtle":   { "$value": "#E8EFFD" },
        "onSubtle": { "$value": "#1D4ED8" }
      },
      "done": {
        "$description": "Завершено позитивно: Выполнено, Принято, Закрыто",
        "solid":    { "$value": "#16A34A" },
        "subtle":   { "$value": "#E9F7EE" },
        "onSubtle": { "$value": "#15803D" }
      },
      "canceled": {
        "$description": "Неактивно: Отменено, Архив",
        "solid":    { "$value": "#6B7280" },
        "subtle":   { "$value": "#F1F2F4" },
        "onSubtle": { "$value": "#4B5563" }
      }
    }
  },
  "font": {
    "$type": "font",
    "family": {
      "sans": { "$value": "\"Golos Text\", \"Inter\", -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif", "$description": "Открытая гарнитура с развитой кириллицей; Inter — нейтральная альтернатива" },
      "mono": { "$value": "\"JetBrains Mono\", \"SF Mono\", Consolas, \"Liberation Mono\", monospace", "$description": "Шифры, версии, ревизии, даты в колонках: PDF-01, v1, R6" }
    },
    "size": {
      "$description": "Шкала по 8pt-сетке. tabular-nums обязателен для табличных данных (даты, версии)",
      "display":    { "$value": "22px", "lineHeight": "28px", "weight": 600, "$description": "Заголовок экрана («Проекты»)" },
      "heading":    { "$value": "18px", "lineHeight": "24px", "weight": 600, "$description": "Заголовок панели (панель замечаний)" },
      "subheading": { "$value": "16px", "lineHeight": "22px", "weight": 600 },
      "bodyLg":     { "$value": "15px", "lineHeight": "22px", "weight": 400, "$description": "Длинное чтение: тексты замечаний" },
      "body":       { "$value": "14px", "lineHeight": "20px", "weight": 400, "$description": "Таблицы, реестры, основной UI" },
      "secondary":  { "$value": "13px", "lineHeight": "18px", "weight": 400, "$description": "Вторичный текст, лейблы фильтров (минимум, без CAPS)" },
      "caption":    { "$value": "12px", "lineHeight": "16px", "weight": 500, "$description": "Метаданные, бейджи. Младше 12px в UI не использовать" }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "$description": "8pt-сетка: 4, 8, 12, 16, 20, 24, 32, 40, 48, 64",
      "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
      "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
    },
    "control": {
      "$description": "Высоты контролов. Радиус единый: 8px (кнопки/поля), 12px (карточки)",
      "sm": "28px", "md": "32px", "lg": "40px"
    },
    "tableRow": {
      "comfortable": "48px", "compact": "36px",
      "$description": "Переключатель плотности таблиц обязателен для CDE"
    },
    "panel": {
      "remarks": "380px",
      "$description": "Панель замечаний: ресайзабельная 360–420px, с collapse"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": "6px", "md": "8px", "lg": "12px", "pill": "999px"
  },
  "shadow": {
    "$type": "shadow",
    "1":   { "$value": "0 1px 2px rgba(25, 25, 23, 0.05)", "$description": "Покой: карточки в потоке" },
    "2":   { "$value": "0 2px 8px rgba(25, 25, 23, 0.08)", "$description": "Приподнятые: дропдауны, поповеры" },
    "3":   { "$value": "0 8px 24px rgba(25, 25, 23, 0.14)", "$description": "Модальные окна" },
    "doc": { "$value": "0 8px 28px rgba(0, 0, 0, 0.30)", "$description": "Лист документа на тёмном canvas вьювера" }
  },
  "duration": {
    "$type": "duration",
    "fast": "120ms", "base": "180ms", "slow": "240ms",
    "$description": "Панели и модалки — slow; hover/press — fast/base. Всегда уважать prefers-reduced-motion"
  },
  "focusRing": {
    "$type": "shadow",
    "$value": "0 0 0 2px #FFFFFF, 0 0 0 4px #2F5BEA",
    "$description": "Видимый фокус-ринг для клавиатурной навигации (WCAG 2.2 AA), не убирать outline программно"
  }
}
