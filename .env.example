# Пример переменных окружения для СОД.
# Скопируйте значения в окружение (PyCharm Run Configuration / systemd / export).
# Файл .env в корне проекта читается автоматически (python-dotenv,
# sod_core/settings.py: load_dotenv).

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# HTTPS / cookies.
# На VPS включите оба флага; локально для HTTP оставьте False.
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True

# PostgreSQL.
# Если POSTGRES_DB задан — используется PostgreSQL, иначе SQLite.
# На сервере дополнительно установите psycopg (в requirements не входит).
# POSTGRES_DB=sod
# POSTGRES_USER=sod
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# ИИ-контур (RAG-поиск, база знаний, отчёт ГИПу).
# Фича-флаг: False — контур выключен (вкладки скрыты, вьюхи отдают 404).
AI_CHECKS_ENABLED=False

# LLM: OrcaRouter (OpenAI-совместимый шлюз, deepseek/*, z-ai/*) или
# GigaChat (Сбер, работа из РФ). Модель из UI с префиксом 'GigaChat-'
# уходит в GigaChatProvider, остальное — в HttpLLMProvider (OrcaRouter).
# Без ключей работает заглушка StubLLMProvider (контур не падает).
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.orcarouter.ai/v1
AI_LLM_MODEL=deepseek-chat
AI_LLM_TIMEOUT=60
# Дефолт-провайдер без явной модели: пусто → OrcaRouter, 'gigachat' → GigaChat.
AI_LLM_PROVIDER=
# GigaChat: Authorization Key (Base64), таймаут, TLS (НУЦ Минцифры или false).
AI_GIGACHAT_AUTH_KEY=
AI_GIGACHAT_MODEL=GigaChat-2
AI_GIGACHAT_TIMEOUT=60
AI_GIGACHAT_VERIFY_SSL=True

# Эмбеддинги bge-m3 (ONNX): папка с model.onnx и токенизатором.
# Без модели индексация/RAG падают с понятной ошибкой (заглушки нет).
AI_EMBEDDING_MODEL_DIR=
