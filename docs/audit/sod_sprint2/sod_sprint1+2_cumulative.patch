+{% extends 'storage/base.html' %}
+{% load static issue_extras %}
+
+{% block title %}Замечания — {{ project.code }} — Stream-CAD{% endblock %}
+
+{% block topbar %}
+    {% include 'storage/_topbar.html' with topbar_project=project topbar_title="Реестр замечаний" %}
+{% endblock %}
+
+{% block content %}
+<main class="container-fluid px-3 py-3 pb-5">
+    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
+        <div>
+            <h1 class="h4 mb-0">Реестр замечаний</h1>
