-def _rect_intersection_area(a: Rect, b: Rect) -> float:
-    """Площадь пересечения двух оси-выровненных прямоугольников."""
-    width = min(a.x1, b.x1) - max(a.x0, b.x0)
-    height = min(a.y1, b.y1) - max(a.y0, b.y0)
-    if width <= 0 or height <= 0:
-        return 0.0
-    return width * height
