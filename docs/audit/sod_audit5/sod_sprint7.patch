+  font-size: 12px;
+  color: var(--c-text-muted);
+}
+
+@media (max-width: 820px) {
+  .recent-documents { margin: 8px 8px 0; }
+  .recent-documents__link { max-width: 100%; }
+  .recent-documents__time { margin-left: 0; width: 100%; }
+}
