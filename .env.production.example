# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# HTTPS / cookies
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True

# PostgreSQL
POSTGRES_DB=sod
POSTGRES_USER=sod
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ИИ-контур (RAG, база знаний, отчёт ГИПу). См. .env.example.
AI_CHECKS_ENABLED=False
# LLM для RAG-ответов и отчётов ГИПу (GigaChat, api.giga.chat/v1).
# Cloud.ru Foundation Models поддерживает только эмбеддинги.
AI_LLM_PROVIDER=gigachat
AI_LLM_MODEL=GigaChat-2-Max
AI_LLM_TIMEOUT=60
# LLM: только GigaChat (Сбер) — OrcaRouter удалён (зачистка 2026-11-10).
AI_GIGACHAT_AUTH_KEY=
AI_GIGACHAT_MODEL=GigaChat-2-Max
AI_GIGACHAT_VERIFY_SSL=True
AI_GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
# Эмбеддинги Cloud.ru Foundation Models (Сбер); смена модели = полная переиндексация.
AI_EMBEDDING_PROVIDER=cloudru
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_API_BASE_URL=https://foundation-models.api.cloud.ru
AI_EMBEDDING_VERIFY_SSL=True
AI_EMBEDDING_DIM=1024
AI_EMBEDDING_MODEL_DIR=
