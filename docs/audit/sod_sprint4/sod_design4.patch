+
+/* ==========================================================================
+   Спринт 4: перекраска Bootstrap-контролов в акцент токенов.
+   Раньше .btn-primary, ссылки и фокус-кольца были бутстраповским #0d6efd —
+   «кислота» жила именно тут. Теперь всё берёт var(--c-accent) = #3D5A98.
+   RGB-константы ниже — числовые двойники #3D5A98 / #2F4A7E для rgba()Bootstrap.
+   При смене акцента в tokens.json обновить их вручную.
+   ========================================================================== */
+:root {
+    --bs-primary: var(--c-accent);
+    --bs-primary-rgb: 61, 90, 152;
+    --bs-link-color: var(--c-accent-on-subtle);
+    --bs-link-color-rgb: 47, 74, 126;
+    --bs-link-hover-color: var(--c-accent);
+}
+
+.btn-primary {
+    --bs-btn-bg: var(--c-accent);
+    --bs-btn-border-color: var(--c-accent);
+    --bs-btn-hover-bg: var(--c-accent-hover);
+    --bs-btn-hover-border-color: var(--c-accent-hover);
+    --bs-btn-active-bg: var(--c-accent-pressed);
+    --bs-btn-active-border-color: var(--c-accent-pressed);
+    --bs-btn-disabled-bg: var(--c-accent);
+    --bs-btn-disabled-border-color: var(--c-accent);
+    --bs-btn-focus-shadow-rgb: 61, 90, 152;
+}
+
+.btn-outline-primary {
+    --bs-btn-color: var(--c-accent);
+    --bs-btn-border-color: var(--c-accent);
+    --bs-btn-hover-bg: var(--c-accent);
+    --bs-btn-hover-border-color: var(--c-accent);
+    --bs-btn-active-bg: var(--c-accent-pressed);
+    --bs-btn-active-border-color: var(--c-accent-pressed);
+    --bs-btn-disabled-color: var(--c-accent);
+    --bs-btn-disabled-border-color: var(--c-accent);
+    --bs-btn-focus-shadow-rgb: 61, 90, 152;
+}
+
+.form-control:focus,
+.form-select:focus {
+    border-color: var(--c-accent);
+    box-shadow: 0 0 0 .2rem var(--c-accent-subtle);
+}
+
+.form-check-input:checked {
+    background-color: var(--c-accent);
+    border-color: var(--c-accent);
+}
+
+.form-check-input:focus {
+    border-color: var(--c-accent);
+    box-shadow: 0 0 0 .2rem var(--c-accent-subtle);
+}
+
+.nav-pills .nav-link.active,
+.nav-pills .show > .nav-link,
+.dropdown-item.active,
+.dropdown-item:active {
+    background-color: var(--c-accent);
+}
+
+.page-item.active .page-link {
+    background-color: var(--c-accent);
+    border-color: var(--c-accent);
+}
+
+.text-bg-primary {
+    background-color: var(--c-accent) !important;
+    color: var(--c-text-inverse) !important;
+}
