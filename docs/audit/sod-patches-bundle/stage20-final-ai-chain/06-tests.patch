+
+
+@override_settings(
+    AI_LLM_PROVIDER='', AI_LLM_API_KEY='', AI_GIGACHAT_AUTH_KEY='',
+)
+class CrossSourceRagTests(TestCase):
+    """Треб. 6: объединение проектных чанков и базы знаний."""
+
+    def setUp(self):
+        self.user = User.objects.create_superuser(
