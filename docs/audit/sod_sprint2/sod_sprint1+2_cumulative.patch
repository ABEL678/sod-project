+            </a>
+        </div>
+    </div>
+
+    <div id="registryPanel"
+         data-project-id="{{ project.pk }}">
+
+        {# ---- Сводка: счётчики по группам — «что требует внимания» ---- #}
+        <div class="card shadow-sm mb-3">
+            <div class="card-body py-2">
+                <div class="d-flex flex-wrap gap-2 align-items-center">
+                    <a class="cde-badge {% if not filters.flag and not filters.status %}cde-badge--accent{% else %}cde-badge--closed{% endif %} text-decoration-none"
