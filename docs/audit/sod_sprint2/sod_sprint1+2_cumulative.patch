+                    <a class="cde-badge {% if filters.flag == 'open' %}cde-badge--accent{% else %}cde-badge--wait{% endif %} text-decoration-none"
+                       href="{% url 'issues:issue_registry' project.pk %}?flag=open">
+                        Открытые <span class="cde-tnum">{{ counts.groups.open }}</span>
+                    </a>
+                    <a class="cde-badge {% if filters.status == 'IN_PROGRESS' %}cde-badge--accent{% else %}cde-badge--progress{% endif %} text-decoration-none"
+                       href="{% url 'issues:issue_registry' project.pk %}?status=IN_PROGRESS">
+                        В работе <span class="cde-tnum">{{ counts.groups.progress }}</span>
+                    </a>
+                    <a class="cde-badge {% if filters.status == 'DONE' %}cde-badge--accent{% else %}cde-badge--review{% endif %} text-decoration-none"
+                       href="{% url 'issues:issue_registry' project.pk %}?status=DONE">
+                        На проверке <span class="cde-tnum">{{ counts.groups.review }}</span>
+                    </a>
+                    <a class="cde-badge {% if filters.flag == 'closed' %}cde-badge--accent{% else %}cde-badge--closed{% endif %} text-decoration-none"
+                       href="{% url 'issues:issue_registry' project.pk %}?flag=closed">
+                        Закрытые <span class="cde-tnum">{{ counts.groups.closed }}</span>
+                    </a>
+                    <a class="cde-badge {% if filters.flag == 'overdue' %}cde-deadline cde-deadline--overdue{% else %}cde-deadline cde-deadline--soon{% endif %} text-decoration-none"
