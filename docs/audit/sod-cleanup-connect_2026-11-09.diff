-                    or box.y0 < rect.y0 - margin
-                    or box.y1 > rect.y1 + margin
-                ):
-                    offscale = True
-                    break
-        if offscale:
-            return []
-
-    if top and bottom and left and right:
-        return []
-    missing = [
-        name for name, found in (
-            ('верх', top), ('низ', bottom),
-            ('лево', left), ('право', right),
