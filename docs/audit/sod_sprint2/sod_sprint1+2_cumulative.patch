+                        <span class="btn btn-secondary disabled cde-tnum">{{ page_obj.number }} / {{ paginator.num_pages }}</span>
+                        {% if page_obj.has_next %}
+                            <a class="btn btn-outline-secondary"
+                               href="?{% if filters.q %}q={{ filters.q|urlencode }}&{% endif %}{% if filters.status %}status={{ filters.status }}&{% endif %}{% if filters.flag %}flag={{ filters.flag }}&{% endif %}{% if filters.assignee %}assignee={{ filters.assignee }}&{% endif %}page={{ page_obj.next_page_number }}">Вперёд →</a>
+                        {% endif %}
+                    </div>
+                </div>
+            {% endif %}
+        </div>
+    </div>
+</main>
+{% endblock %}
+
+{% block extra_js %}
+<script src="{% static 'js/vendor/htmx.min.js' %}"></script>
+{% endblock %}
