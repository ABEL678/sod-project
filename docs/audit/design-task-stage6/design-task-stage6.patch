+        sheet = self._export_workbook(response).active
+        self.assertEqual(sheet.title, 'Открытые задания')
+        self.assertEqual(sheet.cell(row=1, column=1).value, '№')
+        self.assertEqual(sheet.cell(row=1, column=2).value, 'Задание')
