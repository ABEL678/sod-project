+                                {% else %}
+                                    По проекту пока нет замечаний.
+                                {% endif %}
+                            </td>
+                        </tr>
+                    {% endfor %}
+                    </tbody>
+                </table>
+            </div>
+
+            {% if is_paginated %}
+                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
+                    <span class="small text-muted cde-tnum">
+                        Показаны {{ page_obj.start_index }}–{{ page_obj.end_index }} из {{ paginator.count }}
+                    </span>
+                    <div class="btn-group btn-group-sm">
+                        {% if page_obj.has_previous %}
+                            <a class="btn btn-outline-secondary"
+                               href="?{% if filters.q %}q={{ filters.q|urlencode }}&{% endif %}{% if filters.status %}status={{ filters.status }}&{% endif %}{% if filters.flag %}flag={{ filters.flag }}&{% endif %}{% if filters.assignee %}assignee={{ filters.assignee }}&{% endif %}page={{ page_obj.previous_page_number }}">← Назад</a>
